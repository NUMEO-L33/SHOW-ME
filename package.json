{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "processor:dev": "tsx watch processor/src/index.ts",
    "processor:build": "tsc --project processor/tsconfig.build.json",
    "processor:start": "node processor/dist/index.js",
    "processor:test": "tsx --test --test-concurrency=2 processor/tests/**/*.test.ts",
    "processor:postgres:verify": "node processor/scripts/verify-postgres.mjs --local-docker",
    "client:test": "tsx --test lib/**/*.test.ts",
    "processor:typecheck": "tsc --project processor/tsconfig.json --noEmit",
    "processor:preflight": "node --env-file-if-exists=processor/.env --import tsx processor/src/analysis-preflight.ts",
    "processor:gemini:smoke": "node --env-file-if-exists=processor/.env --import tsx processor/src/gemini/smoke.ts",
    "processor:gemini:tokens": "node --env-file-if-exists=processor/.env --import tsx processor/src/gemini/token-probe.ts",
    "processor:gemini:generation": "node --env-file-if-exists=processor/.env --import tsx processor/src/gemini/generation-probe.ts",
    "processor:db:generate": "drizzle-kit generate --config processor/drizzle.config.ts",
    "processor:db:migrate": "drizzle-kit migrate --config processor/drizzle.config.ts",
    "processor:deploy-build": "npm run install:ci && npm run processor:build",
    "processor:deploy-start": "npm run processor:start",
    "check": "npm run processor:typecheck && npm run processor:build && npm run processor:test && npm run client:test && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@replit/object-storage": "^1.0.0",
    "@shadcn/react": "^0.3.0",
    "busboy": "^1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "^19.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
