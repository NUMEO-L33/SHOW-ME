# Runtime
NODE_ENV=development
PORT=8788
# Comma-separated origins. In deployment, use the exact published Sites origin(s); never use *.
CORS_ORIGINS=http://localhost:5173

# Ephemeral working directory for uploads, ffmpeg outputs, and local-development storage.
DATA_DIR=./processor/.data
# Leave blank to use the platform-specific binaries from ffmpeg-static/ffprobe-static.
# Replit deployment uses the ffmpeg-full Nix package and verifies its patched release at startup.
FFMPEG_PATH=
FFPROBE_PATH=
# Required in Replit deployment. Set this to the exact reviewed system pair
# reported by `ffmpeg -version` and `ffprobe -version` (for example 8.1.2).
EXPECTED_MEDIA_VERSION=

# PostgreSQL. Optional only for isolated local media tests; required on Replit deployment.
DATABASE_URL=

# local is for development only. Replit deployments must use replit.
SHOWME_STORAGE=local
# Leave the bucket ID empty to use the Replit app's default bucket.
REPLIT_OBJECT_STORAGE_BUCKET_ID=
REPLIT_OBJECT_STORAGE_PREFIX=showme
# Generate at least 32 random bytes as base64url. Required in Replit deployment.
ASSET_TICKET_SECRET=

# Pipeline tuning
SCENE_THRESHOLD=0.30
MAX_STEPS=24
PORTRAIT_FRAME_WIDTH=720
LANDSCAPE_FRAME_WIDTH=1280

# Timeouts (milliseconds)
REQUEST_TIMEOUT_MS=900000
FFPROBE_TIMEOUT_MS=30000
FFMPEG_TIMEOUT_MS=600000
JOB_TIMEOUT_MS=900000

# Resource and abuse limits
MAX_VIDEO_DURATION_MS=1200000
MAX_VIDEO_DIMENSION=4096
MAX_VIDEO_PIXELS=9000000
MAX_VIDEO_FRAME_RATE=60
MAX_PROCESSING_ATTEMPTS=3
QUEUE_CAPACITY=25

# Gemini: local synthetic-only smoke test. NOT enabled in the upload/API pipeline.
# Keep the actual key only in processor/.env (gitignored); never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Set true only after checking in Google AI Studio that this key's project is Free tier.
# The application cannot determine the billing tier or guarantee a zero bill.
SHOWME_GEMINI_FREE_TIER_CONFIRMED=false
# Set to synthetic-screens-only-v1 only after reviewing docs/GEMINI_SETUP.md.
SHOWME_GEMINI_SYNTHETIC_CONSENT=
